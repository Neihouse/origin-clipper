# Copy to .env.local for local development. Never commit real values.

# --- Database ---
# Any standard Postgres connection string (Neon, Supabase, RDS, local Postgres).
DATABASE_URL="postgres://user:password@host:5432/dbname"

# --- Twitch (see README "Twitch app setup") ---
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""
# Channel login as it appears in the channel URL, e.g. "origin" for twitch.tv/origin
TWITCH_BROADCASTER_LOGIN=""
# Numeric broadcaster user ID (see README for how to look it up)
TWITCH_BROADCASTER_ID=""

# --- Cron auth ---
# Vercel sends this as `Authorization: Bearer <value>` on cron requests.
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# --- Admin auth ---
# scrypt hash of the admin password: npm run hash-password -- 'your-password'
ADMIN_PASSWORD_HASH=""
# Signs admin session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=""

# --- Collection tuning (optional — defaults shown) ---
COLLECTION_WINDOW_DAYS=7
TOP_CLIP_LIMIT=5

# --- Meta (Instagram + Facebook) (see README "Meta app setup") ---
# Facebook Page ID for the Primordial Den Page.
META_PAGE_ID=""
# Instagram Business Account ID linked to that Page.
META_IG_USER_ID=""
# Long-lived Page access token generated via a Business Manager System User.
META_PAGE_ACCESS_TOKEN=""
# Graph API version to call. Defaults to "v21.0" if unset.
META_GRAPH_API_VERSION="v21.0"

# --- Insights refresh tuning (optional — defaults shown) ---
# Only clips published within this many days are refreshed by the cron sweep.
# The manual "Refresh insights" button on a clip's detail page ignores this window.
INSIGHTS_REFRESH_WINDOW_DAYS=14
# Max clips the cron sweep refreshes per invocation.
INSIGHTS_BATCH_SIZE=20

# --- Vercel Blob ---
# Read/write token for re-hosting clip video before publishing to Meta.
# Vercel Project Settings → Storage → Blob (or `vercel env pull` after linking the store).
BLOB_READ_WRITE_TOKEN=""
# A verified two-platform publish keeps its source asset this many days before cleanup.
VIDEO_ASSET_RETENTION_DAYS=7
